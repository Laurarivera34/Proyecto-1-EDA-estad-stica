# Mapa de calor ponderado
df_heat <- cartagena %>%
filter(is.finite(vulnerability_score), is.finite(servicios), is.finite(f_exp_hog), f_exp_hog > 0) %>%
count(vulnerability_score, servicios, wt = f_exp_hog, name = "wt_n") %>%
group_by() %>%
mutate(prop = wt_n / sum(wt_n))
grafico_calor <- ggplot(df_heat, aes(x = vulnerability_score, y = servicios, fill = prop)) +
geom_tile(color = "white") +
scale_fill_gradient(
low = "#E6F4F2",   # tono muy claro
high = "#016B61",  # tono principal
name = "Masa ponderada",
labels = scales::percent_format(accuracy = 0.1)
) +
labs(
title = "Vulnerabilidad vs. Carencias (Mapa de calor ponderado)",
x = "Índice de vulnerabilidad",
y = "Número de carencias"
) +
theme_minimal(base_size = 12)
print(grafico_calor)
