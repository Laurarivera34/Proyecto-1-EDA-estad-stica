bg = "white"
)
# Tendencia Monotónica
df_profile <- cartagena %>%
filter(is.finite(vulnerability_score), is.finite(servicios), is.finite(f_exp_hog), f_exp_hog > 0) %>%
group_by(vulnerability_score) %>%
summarise(
y_mean_w = sum(servicios * f_exp_hog) / sum(f_exp_hog),
n_w      = sum(f_exp_hog),
.groups = "drop"
)
g_tendencia <- ggplot(df_profile, aes(x = vulnerability_score, y = y_mean_w)) +
geom_line() +
