# Distribucion de la correlación y el intervalo de confianza
boots <- boot_res$boots
ci_lo <- as.numeric(quantile(boots, 0.025, na.rm = TRUE))
ci_hi <- as.numeric(quantile(boots, 0.975, na.rm = TRUE))
df_boot <- tibble(rho_boot = boots)
g_boot <- ggplot(df_boot, aes(x = rho_boot)) +
geom_histogram(
bins = 60,
fill = "#9ECFD4",
color = "white",
alpha = 0.9
) +
geom_vline(xintercept = rho_obs, linewidth = 0.7, color = "black") +
geom_vline(xintercept = ci_lo, linetype = "dashed", color = "black") +
geom_vline(xintercept = ci_hi, linetype = "dashed", color = "black") +
labs(
title = "Distribución bootstrap de ρ (Spearman ponderado)",
subtitle = paste0(
"ρ obs = ", round(rho_obs, 4),
"   |   IC 95% ≈ [", round(ci_lo, 4), "; ", round(ci_hi, 4), "]"
),
x = "ρ* (bootstrap)",
y = "Frecuencia"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", color = "black"),
axis.title = element_text(face = "bold"),
axis.text = element_text(color = "gray20")
)
print(g_boot)
ggsave(
filename = "results/grafico19.png",
plot = g_boot,
width = 10,
height = 7,
dpi = 300,
bg = "white"
)
