# Re-ejecutamos la función de permutación guardando las permutaciones para graficar
perm_with_draws <- function(x, y, w, R = 10000, seed = 456){
if(!is.null(seed)) set.seed(seed)
obs <- wCorr::weightedCorr(x, y, method = "Spearman", weights = w)
perms <- replicate(R, {
y_perm <- sample(y, replace = FALSE)
wCorr::weightedCorr(x, y_perm, method = "Spearman", weights = w)
})
p_right <- (sum(perms >= obs) + 1) / (R + 1)  # unilateral derecha
list(obs = obs, perms = perms, p_right = p_right)
}
# Usa tus objetos ya creados en tu script:
x <- cartagena$vulnerability_score
y <- cartagena$servicios
w <- cartagena$f_exp_hog
keep <- is.finite(x) & is.finite(y) & is.finite(w) & w > 0
x <- x[keep]; y <- y[keep]; w <- w[keep]
perm_full <- perm_with_draws(x, y, w, R = 10000, seed = 456)
rho_obs   <- as.numeric(perm_full$obs)
p_right   <- as.numeric(perm_full$p_right)        (unilateral > 0)
p_right   <- as.numeric(perm_full$p_right)
df_perm <- tibble(rho_perm = perm_full$perms)
p_perm <- ggplot(df_perm, aes(x = rho_perm)) +
geom_histogram(bins = 60) +
geom_vline(xintercept = rho_obs, linewidth = 1) +
labs(
title = "Distribución nula (permutación) de ρ (Spearman ponderado)",
subtitle = paste0("ρ observado = ", round(rho_obs, 4),
"    |    p-valor (cola derecha) = ", scales::number(p_right, accuracy = 0.0001)),
x = "ρ bajo H0 (permutaciones de Y)",
y = "Frecuencia"
) +
theme_minimal(base_size = 12)
print(p_perm)
boots <- boot_res$boots
ci_lo <- as.numeric(quantile(boots, 0.025, na.rm = TRUE))
ci_hi <- as.numeric(quantile(boots, 0.975, na.rm = TRUE))
df_boot <- tibble(rho_boot = boots)
p_boot <- ggplot(df_boot, aes(x = rho_boot)) +
geom_histogram(bins = 60) +
geom_vline(xintercept = rho_obs, linewidth = 1) +
geom_vline(xintercept = ci_lo, linetype = "dashed") +
geom_vline(xintercept = ci_hi, linetype = "dashed") +
labs(
title = "Distribución bootstrap de ρ (Spearman ponderado)",
subtitle = paste0("ρ obs = ", round(rho_obs, 4),
"    |    IC 95% ≈ [", round(ci_lo, 4), "; ", round(ci_hi, 4), "]"),
x = "ρ* (bootstrap)",
y = "Frecuencia"
) +
theme_minimal(base_size = 12)
print(p_boot)
g_boot <- ggplot(df_boot, aes(x = rho_boot)) +
geom_histogram(
bins = 60,
fill = "#9ECFD4",
color = "white",
alpha = 0.9
) +
geom_vline(xintercept = rho_obs, linewidth = 1, color = "#016B61") +
geom_vline(xintercept = ci_lo, linetype = "dashed", color = "#016B61") +
geom_vline(xintercept = ci_hi, linetype = "dashed", color = "#016B61") +
labs(
title = "Distribución bootstrap de ρ (Spearman ponderado)",
subtitle = paste0(
"ρ obs = ", round(rho_obs, 4),
"   |   IC 95% ≈ [", round(ci_lo, 4), "; ", round(ci_hi, 4), "]"
),
x = "ρ* (bootstrap)",
y = "Frecuencia"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", color = "#016B61"),
axis.title = element_text(face = "bold"),
axis.text = element_text(color = "gray20")
)
print(g_boot)
